# ---- OpsPilot AI configuration (copy to .env; never commit .env) ----
OPSPILOT_ENV=dev
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_LOG_JSON=true
# ---- Docker Compose (host ports, all bound to 127.0.0.1) ----
# Change these if the defaults are taken on your machine (e.g. by another stack).
OPSPILOT_PG_PORT=5432
OPSPILOT_BACKEND_PORT=8000
OPSPILOT_FRONTEND_PORT=5173
# Local-dev DB credentials (compose creates the user). Change for anything non-local.
OPSPILOT_PG_USER=opspilot
OPSPILOT_PG_PASSWORD=opspilot
OPSPILOT_PG_DB=opspilot

# Used by processes on the host (uv run alembic / pytest). Inside compose the backend
# overrides this with postgres:5432. Keep the port in sync with OPSPILOT_PG_PORT.
OPSPILOT_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@127.0.0.1:5432/opspilot
# Integration tests DROP and recreate all tables here. The DB name must end with _test.
OPSPILOT_TEST_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@127.0.0.1:5432/opspilot_test
OPSPILOT_CORS_ORIGINS=["http://localhost:5173"]

# JWT: REQUIRED to change outside local dev; the placeholder is rejected when OPSPILOT_ENV=prod.
# Generate with  python -c "import secrets;print(secrets.token_urlsafe(48))"
OPSPILOT_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OPSPILOT_JWT_EXPIRE_MINUTES=60

# LLM provider: mock (offline, free) | openai_compatible (Qwen / DashScope)
OPSPILOT_LLM_PROVIDER=mock
OPSPILOT_EMBEDDING_PROVIDER=mock
OPSPILOT_EMBEDDING_DIM=1024
OPSPILOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPSPILOT_LLM_MODEL=qwen-plus
OPSPILOT_EMBEDDING_MODEL=text-embedding-v4
# Fill in only when switching to openai_compatible. Leave empty in mock mode.
OPSPILOT_LLM_API_KEY=
OPSPILOT_LLM_TIMEOUT_S=30

# Demo seed passwords for scripts/seed_demo.py — local demo accounts only, documented in README.
OPSPILOT_SEED_ADMIN_PASSWORD=Admin#2026demo
OPSPILOT_SEED_USER_PASSWORD=User#2026demo
