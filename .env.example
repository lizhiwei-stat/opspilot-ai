# ---- OpsPilot AI configuration (copy to .env; never commit .env) ----
OPSPILOT_ENV=dev
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_LOG_JSON=true
OPSPILOT_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot
# Integration tests use a separate database; tables are dropped/recreated there.
OPSPILOT_TEST_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot_test
OPSPILOT_CORS_ORIGINS=["http://localhost:5173"]

# JWT: generate with  python -c "import secrets;print(secrets.token_urlsafe(48))"
OPSPILOT_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OPSPILOT_JWT_EXPIRE_MINUTES=60

# LLM provider: mock (offline, free) | openai_compatible (Qwen / DashScope)
OPSPILOT_LLM_PROVIDER=mock
OPSPILOT_EMBEDDING_PROVIDER=mock
OPSPILOT_EMBEDDING_DIM=1024
OPSPILOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPSPILOT_LLM_MODEL=qwen-plus
OPSPILOT_EMBEDDING_MODEL=text-embedding-v4
# Fill in only when switching to openai_compatible. Leave empty in mock mode.
OPSPILOT_LLM_API_KEY=
OPSPILOT_LLM_TIMEOUT_S=30

# Demo seed passwords (local demo only)
OPSPILOT_SEED_ADMIN_PASSWORD=Admin#2026demo
OPSPILOT_SEED_USER_PASSWORD=User#2026demo
